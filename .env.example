# Copy this file to .env and fill in values. Never commit .env.
#
# PORT NOTES (this machine)
#   - llama-server serves the local LLM on http://localhost:8000/v1
#   - TaskMaster FastAPI backend listens on http://localhost:8001
#   - TaskLit frontend connects to FastAPI at API_BASE below
# Adjust the URLs if you run the LLM elsewhere.

# Todoist
TODOIST_API_TOKEN=

# Google Calendar
# Path to OAuth credentials.json (do not commit)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_IDS=primary
# Comma-separated list of calendar IDs to query (e.g. primary,work@example.com,family@example.com)
# GOOGLE_CALENDAR_IDS=primary,work@example.com,family@example.com

# LLM Provider Configuration (OpenAI-compatible)
# Works seamlessly with local LLM, OpenRouter, or direct Google Gemini without code changes.

# Option A: Local LLM (llama-server / Ollama)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=/Users/dst/.models/gemma-4-12b-it-Q4_K_M.gguf
LLM_API_KEY=ollama

# Option B: OpenRouter (Google Gemini, Claude, DeepSeek, etc.)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.0-flash-001
# LLM_API_KEY=sk-or-v1-your-openrouter-key

# Option C: Direct Google Gemini (OpenAI compatibility endpoint)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-gemini-api-key

# Timezone for day_start / day_end boundaries (IANA tz name)
TIMEZONE=Europe/Helsinki
