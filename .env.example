# Copy this file to .env and fill in values. Never commit .env.

# Todoist
TODOIST_API_TOKEN=

# Google Calendar
# Path to OAuth credentials.json (do not commit)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_IDS=primary
# Comma-separated list of calendar IDs to query (e.g. primary,work@example.com,family@example.com)
# GOOGLE_CALENDAR_IDS=primary,work@example.com,family@example.com

# Local LLM (Ollama via litellm/instructor)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
