# Configuration for TaskMaster.
#
# Place this file at ~/.config/taskmaster/.env (recommended)
# or copy to .env in the project directory for local development.
#
# PORT NOTES (this machine)
#   - llama-server serves the local LLM on http://localhost:8000/v1
#   - omacrm listens on http://localhost:8001 (sibling project)
#   - TaskMaster FastAPI backend listens on http://localhost:8002
#   - Streamlit frontend listens on http://localhost:8501
# Adjust the URLs if you run the LLM elsewhere.

# Todoist API Token
TODOIST_API_TOKEN=
# Comma-separated list of labels to lock/exclude tasks from TaskMaster (default: lock,locked,taskmaster-lock)
# TODOIST_LOCK_LABELS=lock,locked,taskmaster-lock

# Google Calendar Configuration
# Path to OAuth credentials.json (do not commit)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_IDS=primary
# Comma-separated list of calendar IDs to query (e.g. primary,work@example.com,family@example.com)
# GOOGLE_CALENDAR_IDS=primary,work@example.com,family@example.com

# LLM Provider Configuration
# Multiple backends can be configured and selected dynamically in the TUI / API.
LLM_BACKENDS=local,gemini
LLM_DEFAULT_BACKEND=local

# Optional disk cache directory for LLM triage payloads (default: .cache)
# LLM_CACHE_DIR=.cache

# LAN discovery of LLM servers on other devices (mDNS/ZeroConf, e.g. Bonjour)
# Always on: the "Discover LLMs" action browses _ollama/_llm/_openai._tcp.local.
# and probes any host:port that advertises, so an Ollama box on your WiFi shows
# up automatically (no config). The heavier /24 subnet scan is opt-in:
# LLM_LAN_SCAN=1
# Optionally restrict the subnet scan to specific hosts (comma-separated):
# LLM_LAN_HOSTS=192.168.1.40,media-nas.local

# Backend 1: Local LLM (llama-server / Ollama)
LLM_BACKEND_LOCAL_NAME="Paikallinen Gemma 12B"
LLM_BACKEND_LOCAL_BASE_URL=http://localhost:8000/v1
LLM_BACKEND_LOCAL_MODEL=/Users/dst/.models/gemma-4-12b-it-Q4_K_M.gguf
LLM_BACKEND_LOCAL_API_KEY=ollama
LLM_BACKEND_LOCAL_TIMEOUT=600

# Backend 2: Direct Google Gemini API
LLM_BACKEND_GEMINI_NAME="Google Gemini 3.5 Flash Lite"
LLM_BACKEND_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BACKEND_GEMINI_MODEL=gemini-3.5-flash-lite
LLM_BACKEND_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
LLM_BACKEND_GEMINI_TIMEOUT=30

# Timezone for day_start / day_end boundaries (IANA tz name)
TIMEZONE=Europe/Helsinki
