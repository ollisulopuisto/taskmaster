# Copy this file to .env and fill in values. Never commit .env.
#
# PORT NOTES (this machine)
#   - llama-server serves the local LLM on http://localhost:8000/v1
#   - TaskMaster FastAPI backend listens on http://localhost:8001
#   - TaskLit frontend connects to FastAPI at API_BASE below
# Adjust the URLs if you run the LLM elsewhere.

# Todoist
TODOIST_API_TOKEN=

# Google Calendar
# Path to OAuth credentials.json (do not commit)
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_IDS=primary
# Comma-separated list of calendar IDs to query (e.g. primary,work@example.com,family@example.com)
# GOOGLE_CALENDAR_IDS=primary,work@example.com,family@example.com

# LLM Provider Configuration
# Multiple backends can be configured and selected dynamically in the TUI / API.
LLM_BACKENDS=local,gemini
LLM_DEFAULT_BACKEND=local

# Backend 1: Paikallinen malli (llama-server / Ollama)
LLM_BACKEND_LOCAL_NAME="Paikallinen Gemma 12B"
LLM_BACKEND_LOCAL_BASE_URL=http://localhost:8000/v1
LLM_BACKEND_LOCAL_MODEL=/Users/dst/.models/gemma-4-12b-it-Q4_K_M.gguf
LLM_BACKEND_LOCAL_API_KEY=ollama

# Backend 2: Suora Google Gemini API
LLM_BACKEND_GEMINI_NAME="Google Gemini 3.5 Flash Lite"
LLM_BACKEND_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BACKEND_GEMINI_MODEL=gemini-3.5-flash-lite
LLM_BACKEND_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Timezone for day_start / day_end boundaries (IANA tz name)
TIMEZONE=Europe/Helsinki
